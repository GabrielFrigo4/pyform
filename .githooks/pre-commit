#!/usr/bin/env sh
set -e

echo "🔍 Executando verificações do pre-commit..."

if ! git diff --check --cached; then
    echo "❌ [pre-commit] Erros de whitespace ou EOF detectados." >&2
    exit 1
fi

_md_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)
if [ -n "${_md_files}" ]; then
    if command -v npx > "/dev/null" 2>&1; then
        echo "🎨 Verificando formatação de Markdown..."
        npx prettier --check ${_md_files} || {
            echo "❌ [pre-commit] Formatação de Markdown rejeitada. Execute 'make prettier'." >&2
            exit 1
        }
    fi
fi

_py_files=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ -n "${_py_files}" ]; then
    echo "🐍 Analisando arquivos Python com Ruff..."
    if command -v ruff > "/dev/null" 2>&1; then
        ruff check ${_py_files} || {
            echo "❌ [pre-commit] Falha no Ruff check. Execute 'make lint'." >&2
            exit 1
        }
        ruff format --check ${_py_files} || {
            echo "❌ [pre-commit] Código fora do padrão de formatação. Execute 'make ruff-format'." >&2
            exit 1
        }
    elif command -v uv > "/dev/null" 2>&1; then
        uv run --no-sync ruff check ${_py_files} || {
            echo "❌ [pre-commit] Falha no Ruff check. Execute 'make lint'." >&2
            exit 1
        }
        uv run --no-sync ruff format --check ${_py_files} || {
            echo "❌ [pre-commit] Código fora do padrão de formatação. Execute 'make ruff-format'." >&2
            exit 1
        }
    fi
fi

echo "🧪 Executando testes unitários..."
if command -v uv > "/dev/null" 2>&1; then
    uv run --no-sync python3 -m unittest discover tests 2> "/dev/null" || python3 -m unittest discover tests || {
        echo "❌ [pre-commit] Testes unitários falharam." >&2
        exit 1
    }
elif command -v python3 > "/dev/null" 2>&1; then
    python3 -m unittest discover tests || {
        echo "❌ [pre-commit] Testes unitários falharam." >&2
        exit 1
    }
fi

echo "✅ [pre-commit] Todas as validações passaram com sucesso!"
exit 0